#!/bin/sh
set -eu

remote_name="$1"
remote_url="$2"

case "$remote_name|$remote_url" in
  public\|*|*github.com/eryucheng/suzu-lives.git*|*github.com:eryucheng/suzu-lives.git*)
    ;;
  *)
    exit 0
    ;;
esac

repository_root="$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "拒绝通过 public remote 删除 main。" >&2
    exit 1
  fi
  node "$repository_root/scripts/verify-public-export.mjs" --ref "$local_sha"
done
