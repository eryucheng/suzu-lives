{
  "name": "suzu-lives-console",
  "version": "0.1.0",
  "private": true,
  "author": "儿玉诚也",
  "description": "Local desktop control center for Suzu Lives.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --win zip --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "vite": "^8.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@suzu-lives/agent-registry": "0.1.0",
    "@suzu-lives/browser-automation": "0.1.0",
    "@suzu-lives/claude-integration": "0.1.0",
    "@suzu-lives/conversation-reader": "0.1.0",
    "@suzu-lives/cost-ledger": "0.1.0",
    "@suzu-lives/external-capabilities": "0.1.0",
    "@suzu-lives/image-workbench": "0.1.0",
    "@suzu-lives/iphone-bridge": "0.1.0",
    "@suzu-lives/memory-core": "0.1.0",
    "@suzu-lives/memory-compactor": "0.1.0",
    "@suzu-lives/memory-retriever": "0.1.0",
    "@suzu-lives/memory-visualization": "0.1.0",
    "@suzu-lives/service-connections": "0.1.0",
    "@suzu-lives/task-scheduler": "0.1.0",
    "@suzu-lives/visual-reference-library": "0.1.0",
    "@suzu-lives/voice-design": "0.1.0",
    "@suzu-lives/voice-message": "0.1.0",
    "@suzu-memory/host-adapter": "0.1.0",
    "@suzu-memory/ingestion": "0.1.0",
    "@suzu-memory/providers": "0.1.0",
    "@suzu-memory/service": "0.1.0",
    "electron-updater": "^6.8.9",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suzu-design-system": "0.1.0",
    "ws": "8.18.3"
  },
  "build": {
    "appId": "com.suzulives.console",
    "productName": "Suzu Lives Console",
    "asar": true,
    "asarUnpack": [
      "node_modules/@suzu-lives/iphone-bridge/python/**",
      "node_modules/@suzu-lives/browser-automation/src/web-browser/**",
      "node_modules/@suzu-lives/media-understanding/worker/**",
      "node_modules/@suzu-lives/traveling-merchant/worker/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eryucheng",
        "repo": "suzu-lives",
        "releaseType": "release"
      }
    ],
    "files": [
      "assets/**/*",
      "electron/**/*",
      "renderer/**/*",
      "shared/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Suzu-Lives-Console-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
