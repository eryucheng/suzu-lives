{
  "name": "suzu-lives-console",
  "version": "0.2.0",
  "private": true,
  "author": "儿玉诚也",
  "description": "Local desktop control center for Suzu Lives.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --win zip --x64",
    "dist:installer": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "emoji-datasource-apple": "^15.0.1",
    "vite": "^8.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@suzu-lives/agent-image-generation": "0.1.0",
    "@suzu-lives/agent-lifecycle": "0.1.0",
    "@suzu-lives/agent-runtime": "0.1.0",
    "@suzu-lives/agent-registry": "0.1.0",
    "@suzu-lives/web-browser": "0.1.0",
    "@suzu-lives/cost-ledger": "0.1.0",
    "@suzu-lives/suzu-agent-runtime": "0.1.0",
    "@suzu-lives/external-capabilities": "0.1.0",
    "@suzu-lives/image-workbench": "0.1.0",
    "@suzu-lives/mail-bridge": "0.1.0",
    "@suzu-lives/media-understanding": "0.1.0",
    "@suzu-lives/phone-camera": "0.1.0",
    "@suzu-lives/service-connections": "0.1.0",
    "@suzu-lives/suzu-agent-composition": "0.1.0",
    "@suzu-lives/task-scheduler": "0.1.0",
    "@suzu-lives/visual-reference-library": "0.1.0",
    "@suzu-lives/voice-design": "0.1.0",
    "@suzu-lives/voice-message": "0.1.0",
    "@suzu-memory/host-adapter": "0.1.0",
    "@suzu-memory/providers": "0.1.0",
    "@suzu-memory/service": "0.1.0",
    "electron-updater": "^6.8.9",
    "emoji-mart": "^5.6.0",
    "lunar-typescript": "1.8.6",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suzu-design-system": "0.1.0",
    "ws": "8.18.3"
  },
  "build": {
    "appId": "com.suzulives.console",
    "productName": "Suzu Lives",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./scripts/package-type-hook.cjs",
    "asarUnpack": [
      "node_modules/@suzu-lives/suzu-agent-runtime/**",
      "node_modules/@suzu-lives/mail-bridge/python/**",
      "node_modules/@suzu-lives/web-browser/**",
      "node_modules/@suzu-lives/media-understanding/worker/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../release-keys/eryuchengye.ed25519.pub",
        "to": "release-provenance/eryuchengye.ed25519.pub"
      },
      {
        "from": "../../packages/suzu-agent-runtime/vendor/core/node_modules",
        "to": "agent-core-native/node_modules"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eryucheng",
        "repo": "suzu-lives",
        "releaseType": "release"
      }
    ],
    "files": [
      "assets/**/*",
      "electron/**/*",
      "renderer/**/*",
      "shared/**/*",
      "src/**/*",
      "!node_modules/@suzu-lives/suzu-agent-runtime/scripts/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Suzu-Lives-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  }
}
