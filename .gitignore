node_modules/
# Suzu's selected Agent Core snapshot is source-controlled on purpose.  It is
# not an npm install directory: the build consumes it directly so the desktop
# app does not carry the complete upstream DSH product.
!packages/suzu-agent-runtime/vendor/
!packages/suzu-agent-runtime/vendor/**
__pycache__/
dist/
dist-*/
apps/*/dist/
apps/*/dist-preview/
apps/*/renderer/
# The internal design-system workspace ships its built runtime so a clean
# checkout can build the desktop renderer without any external Git dependency.
!packages/design-system/dist/
!packages/design-system/dist/**
.playwright-cli/
output/playwright/
*.log
logs/

# Local databases, caches and recoverable working state
*.db
*.db-*
*.sqlite
*.sqlite3
cache/
caches/
*.cache
backup/
backups/
*.bak
*.backup

# Local application state and private agent data
data/
runtime/
.env
.env.*
!.env.example

# Secrets and machine-local configuration
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.secret
*.token
*.local.json
*.local.yaml
*.local.yml
