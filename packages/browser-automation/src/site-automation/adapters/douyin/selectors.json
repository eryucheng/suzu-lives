{
  "loginMarkers": [
    "[data-e2e='login-button']",
    "button:has-text('登录')"
  ],
  "accountMarkers": [
    "a[href*='/user/self']"
  ],
  "likeButton": [
    "[data-e2e='feed-active-video'] [data-e2e='video-player-digg']",
    "[data-e2e='video-detail'] [data-e2e='video-player-digg']"
  ],
  "commentButton": [
    "[data-e2e='feed-active-video'] [data-e2e='feed-comment-icon']",
    "[data-e2e='video-detail'] [data-e2e='feed-comment-icon']",
    "[data-e2e='feed-comment-icon']"
  ],
  "commentActivator": [
    ".comment-input-container"
  ],
  "commentInput": [
    "div[contenteditable='true'][data-e2e*='comment']",
    "textarea[placeholder*='评论']",
    "div[contenteditable='true'][aria-label*='评论']",
    "div[contenteditable='true']"
  ],
  "commentSubmit": [
    ".comment-input-container .commentInput-right-ct > div > span:last-child",
    "[data-e2e='comment-publish']"
  ],
  "commentClose": [
    ".comment-header-close-btn"
  ],
  "commentItem": [
    "[data-e2e='comment-item']"
  ],
  "commentMore": [
    "[data-e2e='video-comment-more']"
  ],
  "authorLink": [
    "[data-e2e='feed-active-video'] [data-e2e='video-avatar']",
    "[data-e2e='user-info'] a[href*='/user/']:has(img)",
    "[data-e2e='feed-live'] a[href*='/user/']"
  ],
  "nextButton": [
    "[data-e2e='video-switch-next-arrow']"
  ],
  "liveEntry": [
    "[data-e2e='feed-live'] [data-e2e='live-slider']"
  ],
  "liveExit": [
    "[data-e2e='fullscreen-back']"
  ]
}


