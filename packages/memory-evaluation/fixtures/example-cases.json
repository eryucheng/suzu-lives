{
  "version": 4,
  "description": "可公开的脱敏记忆召回基线样例，不包含真实用户聊天。",
  "cases": [
    {
      "id": "direct-event-museum",
      "title": "直接事件与主体归属",
      "category": "direct-fact",
      "query": "记得我之前去科技馆吗",
      "now": "2026-07-15T12:00:00+08:00",
      "expect": {
        "status": "ready",
        "recallIntent": "event",
        "primaryMemoryIds": ["event-museum"],
        "requiredMemoryIds": ["event-museum"],
        "forbiddenMemoryIds": ["event-breakfast"],
        "contextIncludes": ["科技馆", "机器人展"],
        "expectedSubjects": [
          {
            "memoryId": "event-museum",
            "role": "user",
            "key": "user"
          }
        ],
        "primarySubject": {
          "role": "user",
          "key": "user"
        },
        "maximumContextChars": 1400
      }
    },
    {
      "id": "forward-event-chain",
      "title": "事件向后发展",
      "category": "timeline",
      "query": "科技馆那次后来发生了什么",
      "now": "2026-07-15T12:00:00+08:00",
      "expect": {
        "status": "ready",
        "chainMode": "timeline",
        "chainDirection": "forward",
        "primaryMemoryIds": ["event-museum"],
        "requiredMemoryIds": ["event-museum", "event-dinner"],
        "contextIncludes": ["科技馆", "吃了晚饭"],
        "maximumSelectedMemories": 3
      }
    },
    {
      "id": "original-two-sided-dialogue",
      "title": "原话按需展开双方对话",
      "category": "original-evidence",
      "query": "科技馆那句话我是怎么说的",
      "expect": {
        "status": "ready",
        "recallIntent": "utterance",
        "primaryMemoryIds": ["utterance-user-museum"],
        "contextIncludes": ["对方：我上周六去了科技馆", "我：你还看了机器人展"],
        "maximumSelectedMemories": 1
      }
    },
    {
      "id": "date-only-recall",
      "title": "相对日期定位事件",
      "category": "time",
      "query": "我上周六去干啥了",
      "now": "2026-07-15T12:00:00+08:00",
      "expect": {
        "status": "ready",
        "retrievalMode": "date-filter",
        "requiredMemoryIds": ["event-museum"],
        "contextIncludes": ["科技馆"]
      }
    },
    {
      "id": "no-forced-unrelated-memory",
      "title": "无匹配时不强行召回",
      "category": "no-match",
      "query": "记得我养过企鹅吗",
      "expect": {
        "status": "no-match",
        "emptyContext": true,
        "maximumSelectedMemories": 0
      }
    },
    {
      "id": "generic-clock-question",
      "title": "普通时间问题跳过记忆",
      "category": "no-match",
      "query": "现在几点",
      "expect": {
        "status": "skipped",
        "emptyContext": true,
        "maximumSelectedMemories": 0
      }
    },
    {
      "id": "historical-state-completes-current",
      "title": "旧观念必须补上当前观念",
      "category": "state-lifecycle",
      "query": "你以前是不是觉得鱼很难吃",
      "expect": {
        "status": "ready",
        "primaryMemoryIds": ["belief-fish-old"],
        "requiredMemoryIds": ["belief-fish-old", "belief-fish-current"],
        "contextIncludes": [
          "当前状态：Agent 现在知道有些鱼很好吃",
          "过去的状态（已被后续更新）：Agent 以前觉得鱼很难吃"
        ],
        "maximumSelectedMemories": 2
      }
    },
    {
      "id": "current-state-through-old-wording",
      "title": "当前问题不能返回已过期状态",
      "category": "state-lifecycle",
      "query": "你觉得鱼很难吃吗",
      "expect": {
        "status": "ready",
        "primaryMemoryIds": ["belief-fish-current"],
        "requiredMemoryIds": ["belief-fish-current"],
        "forbiddenMemoryIds": ["belief-fish-old"],
        "contextIncludes": ["Agent 现在知道有些鱼很好吃"],
        "contextExcludes": ["Agent 以前觉得鱼很难吃"],
        "maximumSelectedMemories": 1
      }
    },
    {
      "id": "historical-state-evidence-keeps-current-correction",
      "title": "旧状态依据下钻仍保留当前纠正",
      "category": "progressive-disclosure",
      "query": "有什么依据",
      "anchorMemoryIds": ["belief-fish-old"],
      "expect": {
        "status": "ready",
        "recallIntent": "evidence",
        "retrievalMode": "continuation",
        "disclosureLevel": "evidence",
        "primaryMemoryIds": ["belief-fish-old"],
        "requiredMemoryIds": ["belief-fish-current", "belief-fish-old"],
        "requiredEvidenceIds": ["event-fish-bad-meal"],
        "contextIncludes": [
          "当前状态：Agent 现在知道有些鱼很好吃",
          "过去的状态（已被后续更新）：Agent 以前觉得鱼很难吃",
          "直接依据",
          "处理失败的鱼菜"
        ],
        "maximumSelectedMemories": 2
      }
    },
    {
      "id": "evidence-follow-up",
      "title": "短续问只下钻上一焦点的直接证据",
      "category": "progressive-disclosure",
      "query": "有什么依据",
      "anchorMemoryIds": ["event-museum"],
      "expect": {
        "status": "ready",
        "recallIntent": "evidence",
        "retrievalMode": "continuation",
